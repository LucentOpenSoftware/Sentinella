{
  "name": "gui",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "npm run preflight:staging && tauri build",
    "preflight:staging": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/preflight-staging-versions.ps1",
    "verify:signature": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-updater-signature.ps1",
    "release:manifest": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/generate-update-manifest.ps1",
    "release:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/release-build.ps1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
